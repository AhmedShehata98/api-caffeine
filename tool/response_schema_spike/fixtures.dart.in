typedef Fixture = ({String name, String expected, String schema, String body});

const cases = <Fixture>[
  (
    name: 'Stitch mismatch',
    expected: 'fail',
    schema: r'{"type":"object","required":["user"],"properties":{"user":{"type":"object","required":["id","name"],"properties":{"id":{"type":"integer"},"name":{"type":"string"}}}}}',
    body: r'{"user":{"id":"42"}}',
  ),
  (
    name: 'Stitch pass',
    expected: 'pass',
    schema: r'{"type":"object","required":["user"],"properties":{"user":{"type":"object","required":["id","name"],"properties":{"id":{"type":"integer"},"name":{"type":"string"}}}}}',
    body: r'{"user":{"id":42,"name":"Ada"}}',
  ),
  (
